<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>EchelonFoundry.Fides</PackageId>
    <AssemblyName>Fides</AssemblyName>
    <RootNamespace>Fides</RootNamespace>
    <Description>Fides (Echelon Foundry): the pure core of the Echelon single sign-on boundary. Provider model, GitHub App provider and the code-for-token exchange; every effect is explicit data.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Secrets.fs" />
    <Compile Include="Http.fs" />
    <Compile Include="Effect.fs" />
    <Compile Include="JsonRead.fs" />
    <Compile Include="JsonWrite.fs" />
    <Compile Include="Pkce.fs" />
    <Compile Include="Provider.fs" />
    <Compile Include="GitHub.fs" />
    <Compile Include="Configuration.fs" />
    <Compile Include="Protocol.fs" />
    <Compile Include="Exchange.fs" />
    <Compile Include="Service.fs" />
  </ItemGroup>
</Project>
