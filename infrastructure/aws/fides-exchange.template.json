{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Fides exchange: a stateless AWS Lambda function behind an API Gateway HTTP API on a custom domain. Deploy once per environment, each with its own GitHub App. Holds no secret: the client secret stays in AWS Secrets Manager.",
  "Parameters": {
    "EnvironmentName": {
      "Type": "String",
      "AllowedValues": [
        "test",
        "staging",
        "production"
      ],
      "Description": "The environment this stack serves. Each environment has its own GitHub App registration."
    },
    "DomainName": {
      "Type": "String",
      "AllowedPattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$",
      "Description": "The exchange's host name, for example auth.example.com. Point a DNS CNAME or alias at the RegionalDomainName output."
    },
    "CertificateArn": {
      "Type": "String",
      "AllowedPattern": "^arn:aws[a-z-]*:acm:[a-z0-9-]+:[0-9]{12}:certificate/.+$",
      "Description": "An issued ACM certificate for DomainName, in the stack's region."
    },
    "GitHubClientId": {
      "Type": "String",
      "AllowedPattern": "^Iv[0-9A-Za-z._-]+$",
      "Description": "The GitHub App's client ID (not the App ID). Public."
    },
    "ClientSecretArn": {
      "Type": "String",
      "AllowedPattern": "^arn:aws[a-z-]*:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:.+$",
      "Description": "The Secrets Manager secret whose SecretString is the GitHub App client secret. The template never sees the secret."
    },
    "ApplicationsJson": {
      "Type": "String",
      "MinLength": 2,
      "Description": "The registered applications as a JSON array: [{\"id\",\"provider\":\"github\",\"origins\",\"redirectUris\",\"requiredRepository\"?}]. See docs/hosting/AWS.md."
    },
    "CodeBucket": {
      "Type": "String",
      "Description": "The S3 bucket holding the function package (fides-exchange-linux-arm64.zip)."
    },
    "CodeKey": {
      "Type": "String",
      "Description": "The S3 key of the function package."
    },
    "ThrottleRatePerSecond": {
      "Type": "Number",
      "Default": 20,
      "MinValue": 1,
      "Description": "Steady-state requests per second the API accepts."
    },
    "ThrottleBurst": {
      "Type": "Number",
      "Default": 40,
      "MinValue": 1,
      "Description": "Burst requests the API accepts."
    },
    "LogRetentionDays": {
      "Type": "Number",
      "Default": 30,
      "AllowedValues": [
        1,
        3,
        5,
        7,
        14,
        30,
        60,
        90,
        120,
        150,
        180,
        365,
        400,
        545,
        731,
        1096,
        1827,
        2192,
        2557,
        2922,
        3288,
        3653
      ],
      "Description": "How long function and access logs are kept."
    }
  },
  "Resources": {
    "FunctionLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/fides-exchange-${EnvironmentName}"
        },
        "RetentionInDays": {
          "Ref": "LogRetentionDays"
        }
      }
    },
    "AccessLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/apigateway/fides-exchange-${EnvironmentName}"
        },
        "RetentionInDays": {
          "Ref": "LogRetentionDays"
        }
      }
    },
    "FunctionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "fides-exchange",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "WriteOwnLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "${FunctionLogGroup.Arn}"
                  }
                },
                {
                  "Sid": "ReadClientSecretOnly",
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "ClientSecretArn"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Function": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "fides-exchange-${EnvironmentName}"
        },
        "Description": "Fides code-for-token exchange (stateless; holds no data).",
        "Runtime": "provided.al2023",
        "Handler": "bootstrap",
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 256,
        "Timeout": 15,
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "Role": {
          "Fn::GetAtt": [
            "FunctionRole",
            "Arn"
          ]
        },
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "FunctionLogGroup"
          },
          "LogFormat": "Text"
        },
        "Environment": {
          "Variables": {
            "FIDES_CONFIGURATION": {
              "Fn::Sub": "{\"providers\":{\"github\":{\"clientId\":\"${GitHubClientId}\",\"clientSecret\":\"${ClientSecretArn}\"}},\"applications\":${ApplicationsJson}}"
            }
          }
        },
        "Tags": [
          {
            "Key": "system",
            "Value": "fides"
          },
          {
            "Key": "environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          }
        ]
      }
    },
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {
          "Fn::Sub": "fides-exchange-${EnvironmentName}"
        },
        "ProtocolType": "HTTP",
        "DisableExecuteApiEndpoint": true,
        "Tags": {
          "system": "fides",
          "environment": {
            "Ref": "EnvironmentName"
          }
        }
      }
    },
    "Integration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "Function",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 20000
      }
    },
    "Stage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingRateLimit": {
            "Ref": "ThrottleRatePerSecond"
          },
          "ThrottlingBurstLimit": {
            "Ref": "ThrottleBurst"
          }
        },
        "AccessLogSettings": {
          "DestinationArn": {
            "Fn::GetAtt": [
              "AccessLogGroup",
              "Arn"
            ]
          },
          "Format": "{\"requestId\":\"$context.requestId\",\"routeKey\":\"$context.routeKey\",\"status\":\"$context.status\",\"latency\":\"$context.responseLatency\",\"integrationStatus\":\"$context.integrationStatus\"}"
        }
      }
    },
    "InvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Function"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${HttpApi}/*"
        }
      }
    },
    "CustomDomain": {
      "Type": "AWS::ApiGatewayV2::DomainName",
      "Properties": {
        "DomainName": {
          "Ref": "DomainName"
        },
        "DomainNameConfigurations": [
          {
            "CertificateArn": {
              "Ref": "CertificateArn"
            },
            "EndpointType": "REGIONAL",
            "SecurityPolicy": "TLS_1_2"
          }
        ]
      }
    },
    "ApiMapping": {
      "Type": "AWS::ApiGatewayV2::ApiMapping",
      "DependsOn": "Stage",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "DomainName": {
          "Ref": "CustomDomain"
        },
        "Stage": "$default"
      }
    },
    "TokenPostRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "POST /v1/token",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        }
      }
    },
    "TokenOptionsRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "OPTIONS /v1/token",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        }
      }
    },
    "RefreshPostRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "POST /v1/refresh",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        }
      }
    },
    "RefreshOptionsRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "OPTIONS /v1/refresh",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        }
      }
    },
    "RevokePostRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "POST /v1/revoke",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        }
      }
    },
    "RevokeOptionsRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "OPTIONS /v1/revoke",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        }
      }
    }
  },
  "Outputs": {
    "ExchangeUrl": {
      "Description": "The base URL applications configure as the Fides exchange.",
      "Value": {
        "Fn::Sub": "https://${DomainName}"
      }
    },
    "RegionalDomainName": {
      "Description": "Point DomainName's DNS record (CNAME, or Route 53 alias) here.",
      "Value": {
        "Fn::GetAtt": [
          "CustomDomain",
          "RegionalDomainName"
        ]
      }
    },
    "RegionalHostedZoneId": {
      "Description": "The hosted zone ID for a Route 53 alias record.",
      "Value": {
        "Fn::GetAtt": [
          "CustomDomain",
          "RegionalHostedZoneId"
        ]
      }
    },
    "FunctionName": {
      "Value": {
        "Ref": "Function"
      }
    }
  }
}
