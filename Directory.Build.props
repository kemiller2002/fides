<Project>
  <PropertyGroup>
    <!-- The release version. 0.0.0 means "not released yet": the release
         workflow builds, tests and packs it but never publishes it. -->
    <Version>0.2.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Authors>Kevin Miller</Authors>
    <Company>Echelon Foundry</Company>
    <RepositoryUrl>https://github.com/kemiller2002/fides</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/kemiller2002/fides</PackageProjectUrl>
    <PackageTags>echelon;fides;sso;oauth;pkce;github-app;fsharp;wasm</PackageTags>
  </PropertyGroup>
</Project>
